PROGRAM stacks
NOOP
INCLUDE c0de/math
NOOP
FUNCTION calculate
    PARAMETER items INTEGER
    RESULT stacks INTEGER
    RESULT rest INTEGER
BEGIN
    VARIABLE size INTEGER 64
    CALL c0de/math/DIV
        PARAMETER dividend items ;
        PARAMETER divisor size ;
        RESULT result stacks
    ASSIGN rest items \ size ;
END FUNCTION
