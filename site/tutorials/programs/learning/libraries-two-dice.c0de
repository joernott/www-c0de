PROGRAM dice
NOOP
INCLUDE c0de/math
INCLUDE c0de/minecraft
NOOP
FUNCTION roll
BEGIN
    VARIABLE chance FLOAT
    VARIABLE first INTEGER
    VARIABLE second INTEGER
    CALL c0de/math/RANDOM
        RESULT result chance
    CALL c0de/math/INT
        PARAMETER value chance * 6 + 1 ;
        RESULT result first
    CALL c0de/math/RANDOM
        RESULT result chance
    CALL c0de/math/INT
        PARAMETER value chance * 6 + 1 ;
        RESULT result second
    CALL c0de/minecraft/SOUND
        PARAMETER note 12 ;
        PARAMETER instrument "bell" ;
    CALL c0de/minecraft/SAY
        PARAMETER message "You rolled " ⊕ first ⊕ " and " ⊕ second ⊕ ": " ⊕ ( first + second ) ;
END FUNCTION
