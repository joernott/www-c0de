PROGRAM repair
NOOP
NOOP
FUNCTION share
    PARAMETER rows INTEGER
    PARAMETER length INTEGER
    PARAMETER players INTEGER
    RESULT wheat INTEGER
    RESULT each FLOAT
BEGIN
    ASSIGN wheat rows * length ;
    IF players < 1 ;
    BEGIN
        CALL RAISE
            PARAMETER code 1001 ;
            PARAMETER message "Nobody to share with" ;
    END IF
    ASSIGN each wheat / players ;
END FUNCTION
