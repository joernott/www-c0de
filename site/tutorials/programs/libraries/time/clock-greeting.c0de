PROGRAM wallclock
NOOP
INCLUDE c0de/time
INCLUDE c0de/strings
INCLUDE c0de/math
VARIABLE greetings ARRAY STRING
BEGIN
    "Good night    " "Good morning  " "Good afternoon" "Good evening  "
END VARIABLE
NOOP
FUNCTION tick
BEGIN
    VARIABLE now TIME
    VARIABLE hour INTEGER
    VARIABLE quarter INTEGER
    VARIABLE clock STRING
    CALL c0de/time/NOW
        RESULT result now
    CALL c0de/strings/FORMAT
        PARAMETER value now ;
        PARAMETER format "%tT" ;
        RESULT result clock
    CALL c0de/time/HOUR
        PARAMETER time now ;
        RESULT result hour
    CALL c0de/math/DIV
        PARAMETER dividend hour ;
        PARAMETER divisor 6 ;
        RESULT result quarter
    CALL LOCATE
        PARAMETER row 3 ;
        PARAMETER column 12 ;
    CALL PRINT
        PARAMETER value clock ;
    CALL LOCATE
        PARAMETER row 5 ;
        PARAMETER column 9 ;
    CALL PRINT
        PARAMETER value greetings[quarter] ;
END FUNCTION
