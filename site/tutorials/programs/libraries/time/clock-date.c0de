PROGRAM wallclock
NOOP
INCLUDE c0de/time
INCLUDE c0de/strings
NOOP
FUNCTION tick
BEGIN
    VARIABLE now TIME
    VARIABLE clock STRING
    VARIABLE date STRING
    CALL c0de/time/NOW
        RESULT result now
    CALL c0de/strings/FORMAT
        PARAMETER value now ;
        PARAMETER format "%tT" ;
        RESULT result clock
    CALL c0de/strings/FORMAT
        PARAMETER value now ;
        PARAMETER format "%tF" ;
        RESULT result date
    CALL LOCATE
        PARAMETER row 3 ;
        PARAMETER column 12 ;
    CALL PRINT
        PARAMETER value clock ;
    CALL LOCATE
        PARAMETER row 4 ;
        PARAMETER column 11 ;
    CALL PRINT
        PARAMETER value date ;
END FUNCTION
