PROGRAM compass
NOOP
INCLUDE c0de/math
NOOP
FUNCTION measure
    PARAMETER dx FLOAT
    PARAMETER dy FLOAT
    PARAMETER dz FLOAT
    RESULT distance FLOAT
    RESULT walk FLOAT
    RESULT stepX INTEGER
    RESULT stepY INTEGER
    RESULT stepZ INTEGER
    RESULT direction STRING
BEGIN
    VARIABLE size FLOAT
    CALL c0de/math/SQR
        PARAMETER value dx ^ 2 + dy ^ 2 + dz ^ 2 ;
        RESULT result distance
    CALL c0de/math/ABS
        PARAMETER value dx ;
        RESULT result size
    ASSIGN walk size ;
    CALL c0de/math/ABS
        PARAMETER value dy ;
        RESULT result size
    ASSIGN walk walk + size ;
    CALL c0de/math/ABS
        PARAMETER value dz ;
        RESULT result size
    ASSIGN walk walk + size ;
    CALL c0de/math/SGN
        PARAMETER value dx ;
        RESULT result stepX
    CALL c0de/math/SGN
        PARAMETER value dy ;
        RESULT result stepY
    CALL c0de/math/SGN
        PARAMETER value dz ;
        RESULT result stepZ
    IF stepZ = -1 ;
    BEGIN
        ASSIGN direction "north" ;
    END IF
    IF stepZ = 1 ;
    BEGIN
        ASSIGN direction "south" ;
    END IF
    IF stepX ≠ 0 AND stepZ ≠ 0 ;
    BEGIN
        ASSIGN direction direction ⊕ "-" ;
    END IF
    IF stepX = 1 ;
    BEGIN
        ASSIGN direction direction ⊕ "east" ;
    END IF
    IF stepX = -1 ;
    BEGIN
        ASSIGN direction direction ⊕ "west" ;
    END IF
    IF direction = "" ;
    BEGIN
        ASSIGN direction "above or below" ;
    END IF
END FUNCTION
