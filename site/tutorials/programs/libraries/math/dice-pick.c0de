PROGRAM reward
NOOP
INCLUDE c0de/math
VARIABLE prizes ARRAY STRING
BEGIN
    "diamond" "emerald" "gold_ingot" "iron_ingot" "bread"
END VARIABLE
NOOP
FUNCTION pick
    PARAMETER seed INTEGER 0
    RESULT prize STRING
BEGIN
    VARIABLE chance FLOAT
    VARIABLE count INTEGER
    VARIABLE index INTEGER
    IF seed ≠ 0 ;
    BEGIN
        CALL c0de/math/RANDOMIZE
            PARAMETER seed seed ;
    END IF
    CALL LEN
        PARAMETER value prizes ;
        RESULT result count
    CALL c0de/math/RANDOM
        RESULT result chance
    CALL c0de/math/INT
        PARAMETER value chance * count ;
        RESULT result index
    ASSIGN prize prizes[index] ;
    CALL PRINT
        PARAMETER value "You win: " ⊕ prize ;
END FUNCTION
