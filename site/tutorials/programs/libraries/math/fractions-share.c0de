PROGRAM fairshare
NOOP
INCLUDE c0de/math
NOOP
FUNCTION share
    PARAMETER items INTEGER
    PARAMETER players INTEGER
    RESULT each INTEGER
    RESULT rest INTEGER
BEGIN
    CALL c0de/math/DIV
        PARAMETER dividend items ;
        PARAMETER divisor players ;
        RESULT result each
    ASSIGN rest items \ players ;
    CALL PRINT
        PARAMETER value players ⊕ " players get " ⊕ each ⊕ " each, " ⊕ rest ⊕ " left" ;
END FUNCTION
NOOP
FUNCTION average
    PARAMETER counts ARRAY INTEGER
    RESULT exact FLOAT
    RESULT rounded INTEGER
BEGIN
    VARIABLE sum INTEGER
    VARIABLE size INTEGER
    VARIABLE total FLOAT
    CALL LEN
        PARAMETER value counts ;
        RESULT result size
    IF size = 0 ;
    BEGIN
        RETURN
    END IF
    EACH count counts
    BEGIN
        ASSIGN sum sum + count ;
    END EACH
    CALL c0de/math/TO_FLOAT
        PARAMETER value sum ;
        RESULT result total
    ASSIGN exact total / size ;
    CALL c0de/math/ROUND
        PARAMETER value exact ;
        RESULT result rounded
    CALL PRINT
        PARAMETER value size ⊕ " chests, average " ⊕ exact ⊕ ", about " ⊕ rounded ;
END FUNCTION
NOOP
FUNCTION compare
    PARAMETER value FLOAT
    RESULT rounded INTEGER
    RESULT down INTEGER
    RESULT cut INTEGER
BEGIN
    CALL c0de/math/ROUND
        PARAMETER value value ;
        RESULT result rounded
    CALL c0de/math/INT
        PARAMETER value value ;
        RESULT result down
    CALL c0de/math/FIX
        PARAMETER value value ;
        RESULT result cut
END FUNCTION
