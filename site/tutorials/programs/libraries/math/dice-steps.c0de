PROGRAM randomsteps
NOOP
INCLUDE c0de/math
NOOP
FUNCTION compare
    PARAMETER rolls INTEGER 120
    PARAMETER seed INTEGER 42
    RESULT withInt ARRAY INTEGER
    RESULT withFix ARRAY INTEGER
BEGIN
    VARIABLE chance FLOAT
    VARIABLE step INTEGER
    VARIABLE slot INTEGER
    FOR i INTEGER 0 ; 2 ;
    BEGIN
        ASSIGN withInt[i] 0 ;
        ASSIGN withFix[i] 0 ;
    END FOR
    CALL c0de/math/RANDOMIZE
        PARAMETER seed seed ;
    FOR i INTEGER 1 ; rolls ;
    BEGIN
        CALL c0de/math/RANDOM
            RESULT result chance
        CALL c0de/math/INT
            PARAMETER value chance * 3 - 1 ;
            RESULT result step
        ASSIGN slot step + 1 ;
        ASSIGN withInt[slot] withInt[slot] + 1 ;
        CALL c0de/math/FIX
            PARAMETER value chance * 3 - 1 ;
            RESULT result step
        ASSIGN slot step + 1 ;
        ASSIGN withFix[slot] withFix[slot] + 1 ;
    END FOR
END FUNCTION
