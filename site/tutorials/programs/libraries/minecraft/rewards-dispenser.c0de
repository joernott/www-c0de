PROGRAM dispensergame
NOOP
INCLUDE c0de/math
INCLUDE c0de/minecraft
INCLUDE c0de/time
NOOP
FUNCTION prizeFor
    PARAMETER tries INTEGER
    RESULT prize INTEGER
BEGIN
    IF tries ≤ 10 ;
    BEGIN
        ASSIGN prize 1 ;
    END IF
    IF tries ≤ 7 ;
    BEGIN
        ASSIGN prize 3 ;
    END IF
    IF tries ≤ 5 ;
    BEGIN
        ASSIGN prize 5 ;
    END IF
END FUNCTION
NOOP
FUNCTION play
BEGIN
    VARIABLE chance FLOAT
    VARIABLE secret INTEGER
    VARIABLE guess INTEGER
    VARIABLE tries INTEGER
    VARIABLE prize INTEGER
    VARIABLE spot STRUCT c0de/minecraft/POSITION
    CALL c0de/math/RANDOM
        RESULT result chance
    CALL c0de/math/INT
        PARAMETER value chance * 100 + 1 ;
        RESULT result secret
    CALL CLS
    CALL PRINT
        PARAMETER value "I am thinking of a number from 1 to 100." ;
    REPEAT
    BEGIN
        CALL INPUT
            PARAMETER variable guess ;
        ASSIGN tries tries + 1 ;
        IF guess < secret ;
        BEGIN
            CALL PRINT
                PARAMETER value guess ⊕ " is too low." ;
        END IF
        IF guess > secret ;
        BEGIN
            CALL PRINT
                PARAMETER value guess ⊕ " is too high." ;
        END IF
    END REPEAT guess ≠ secret ;
    CALL prizeFor
        PARAMETER tries tries ;
        RESULT prize prize
    CALL PRINT
        PARAMETER value "Right after " ⊕ tries ⊕ " tries! Prize: " ⊕ prize ⊕ " diamonds." ;
    IF prize = 0 ;
    BEGIN
        RETURN
    END IF
    ASSIGN spot.x PID.x ;
    ASSIGN spot.y PID.y + 1 ;
    ASSIGN spot.z PID.z - 2 ;
    FOR i INTEGER 1 ; prize ;
    BEGIN
        CALL c0de/minecraft/PRESS_BUTTON
            PARAMETER position spot ;
        CALL c0de/time/SLEEP
            PARAMETER ticks 30 ;
    END FOR
END FUNCTION
