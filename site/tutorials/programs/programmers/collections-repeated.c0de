PROGRAM words
NOOP
INCLUDE c0de/strings
NOOP
FUNCTION countWords
    PARAMETER text STRING
    RESULT counts HASH INTEGER
    RESULT words INTEGER
BEGIN
    VARIABLE length INTEGER
    VARIABLE word STRING
    VARIABLE known BOOLEAN
    CALL c0de/strings/LCASE
        PARAMETER text text ⊕ " " ;
        RESULT result text
    CALL LEN
        PARAMETER value text ;
        RESULT result length
    FOR i INTEGER 0 ; length - 1 ;
    BEGIN
        IF text[i] ≠ ' ' ;
        BEGIN
            ASSIGN word word ⊕ text[i] ;
        END
        ELSE
        BEGIN
            IF word ≠ "" ;
            BEGIN
                CALL HAS_KEY
                    PARAMETER hash counts ;
                    PARAMETER key word ;
                    RESULT result known
                IF NOT known ;
                BEGIN
                    ASSIGN counts[word] 0 ;
                END IF
                ASSIGN counts[word] counts[word] + 1 ;
                ASSIGN words words + 1 ;
                ASSIGN word "" ;
            END IF
        END IF
    END FOR
END FUNCTION
NOOP
FUNCTION repeated
    PARAMETER text STRING
    RESULT words ARRAY STRING
BEGIN
    VARIABLE counts HASH INTEGER
    VARIABLE next INTEGER
    CALL countWords
        PARAMETER text text ;
        RESULT counts counts
    EACH word counts
    BEGIN
        IF counts[word] > 1 ;
        BEGIN
            ASSIGN words[next] word ;
            ASSIGN next next + 1 ;
        END IF
    END EACH
END FUNCTION
