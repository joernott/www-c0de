PROGRAM numbers
NOOP
INCLUDE c0de/math
NOOP
FUNCTION divide
    PARAMETER a INTEGER 7
    PARAMETER b INTEGER 2
    RESULT quotient FLOAT
    RESULT whole INTEGER
    RESULT floor INTEGER
    RESULT rest INTEGER
    RESULT check BOOLEAN
    RESULT exact BOOLEAN
BEGIN
    ASSIGN quotient a / b ;
    CALL c0de/math/DIV
        PARAMETER dividend a ;
        PARAMETER divisor b ;
        RESULT result whole
    CALL c0de/math/INT
        PARAMETER value quotient ;
        RESULT result floor
    ASSIGN rest a \ b ;
    ASSIGN check whole * b + rest = a ;
    ASSIGN exact 0.1 + 0.2 = 0.3 ;
END FUNCTION
